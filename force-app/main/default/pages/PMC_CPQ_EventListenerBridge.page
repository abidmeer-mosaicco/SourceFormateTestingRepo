<apex:page lightningStylesheets="true">
    <apex:includeScript value="{!URLFOR($Resource.CometD)}"/>
    <script src="/soap/ajax/58.0/connection.js" type="text/javascript"></script>
    <script>
        (function() {
            function getUrlParam(name) {
                name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
                var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
                    results = regex.exec(window.location.search);
                return results === null ? null : decodeURIComponent(results[1].replace(/\+/g, " "));
            }

            var eventName = getUrlParam('event');
            if (!eventName) {
                window.parent.postMessage({ type: 'cometd-error', error: 'No event name provided' }, '*');
                return;
            }

            if (typeof org === 'undefined' || typeof org.cometd === 'undefined') {
                window.parent.postMessage({ type: 'cometd-error', error: 'CometD library failed to load' }, '*');
                return;
            }

            var cometd = new org.cometd.CometD();
            var subscription;
            var sessionId = '{!$Api.Session_ID}';
            var config = {
                url: window.location.protocol + '//' + window.location.host + '/cometd/58.0',
                requestHeaders: {
                    Authorization: 'OAuth ' + sessionId,
                    'Content-Type': 'application/json'
                },
                appendMessageTypeToURL: false,
                maxNetworkDelay: 10000,
                backoffIncrement: 1000,
                maxBackoff: 60000,
                logLevel: 'warn'
            };
            cometd.websocketEnabled = false;
            cometd.configure(config);
            cometd.handshake({}, function(handshakeReply) {
                if (handshakeReply.successful) {
                    subscription = cometd.subscribe(eventName, function(message) {
                        window.parent.postMessage({ type: 'cometd-event', event: eventName, payload: message.data }, '*');
                        // Optionally, unsubscribe after first event:
                        // cometd.unsubscribe(subscription);
                        // cometd.disconnect();
                    }, function(subscribeReply) {
                        if (!subscribeReply.successful) {
                            window.parent.postMessage({ type: 'cometd-error', error: 'Failed to subscribe to event: ' + eventName }, '*');
                        }
                    });
                } else {
                    window.parent.postMessage({ type: 'cometd-error', error: 'CometD handshake failed' }, '*');
                }
            });

            window.addEventListener('beforeunload', function() {
                if (cometd) {
                    if (subscription) {
                        cometd.unsubscribe(subscription);
                    }
                    cometd.disconnect();
                }
            });
        })();
    </script>
    <div style="display:none"></div>
</apex:page>