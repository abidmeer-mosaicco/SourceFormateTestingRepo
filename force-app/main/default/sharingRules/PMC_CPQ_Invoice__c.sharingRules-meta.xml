<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>PMC_CPQ_InvoiceBR</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing rule is to provision Read Access to BR Orders.</description>
        <label>R Invoice BR</label>
        <sharedTo>
            <group>PMC_CPQ_BROrderRAccessGroup</group>
        </sharedTo>
        <criteriaItems>
            <field>PMC_CPQ_Region__c</field>
            <operation>equals</operation>
            <value>Brazil,Global</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMC_CPQ_RInvoiceNA</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing rule is to provision Read Access to NA Orders.</description>
        <label>R InvoiceNA</label>
        <sharedTo>
            <group>PMC_CPQ_NAOrderREAccessGroup</group>
        </sharedTo>
        <criteriaItems>
            <field>PMC_CPQ_Region__c</field>
            <operation>equals</operation>
            <value>Global,North America</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
