    <sharingCriteriaRules>
        <fullName>NA_SSR_Write_Access_on_Account</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>None</contactAccessLevel>
            <opportunityAccessLevel>Edit</opportunityAccessLevel>
        </accountSettings>
        <description>This rule share NA Account record to NA SSR with Read/Write access.</description>
        <label>NA SSR Write Access on Account</label>
        <sharedTo>
            <role>PMC_SS_NASalesServiceRepresentativeSSR</role>
        </sharedTo>
        <criteriaItems>
            <field>PMC_CPQ_Region__c</field>
            <operation>equals</operation>
            <value>North America</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
