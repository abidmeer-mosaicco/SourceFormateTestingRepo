    <sharingCriteriaRules>
        <fullName>PMC_CLM_ShareBrazilQuoteswithBrazilLegalTeam</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing rule will be used to share all Quotes of Brazil region with the members of Brazil Legal Group</description>
        <label>Share Brazil Quotes with Brazil Legal Team</label>
        <sharedTo>
            <group>PMC_CLM_LegalUserBrazil</group>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>PMC_CPQ_Region__c</field>
            <operation>equals</operation>
            <value>Brazil</value>
        </criteriaItems>
        <criteriaItems>
            <field>PMC_CPQ_Region__c</field>
            <operation>equals</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
