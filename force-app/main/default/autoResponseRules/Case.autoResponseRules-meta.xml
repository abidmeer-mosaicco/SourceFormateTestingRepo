<?xml version="1.0" encoding="UTF-8"?>
<AutoResponseRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <autoResponseRule>
        <fullName>PMC SS Case Auto Response Rule</fullName>
        <active>true</active>
        <ruleEntry>
            <booleanFilter>1 AND 2 AND (3 OR 4) AND 5</booleanFilter>
            <criteriaItems>
                <field>Case.Origin</field>
                <operation>equals</operation>
                <value>Email</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.SuppliedEmail</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Account.BillingCountry</field>
                <operation>equals</operation>
                <value>Brazil</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.ContactEmail</field>
                <operation>equals</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Priority</field>
                <operation>equals</operation>
                <value>High</value>
            </criteriaItems>
            <notifyCcRecipients>false</notifyCcRecipients>
            <replyToEmail>customerservice.brasil@mosaicco.com</replyToEmail>
            <senderEmail>noreply.customer.service@mosaicco.com</senderEmail>
            <senderName>Mosaic Support</senderName>
            <template>unfiled$public/PMC_SS_Case_Auto_Response_BR</template>
        </ruleEntry>
        <ruleEntry>
            <booleanFilter>1 AND (2 OR 3 OR 4 OR 5 OR 6) AND 7 AND 8</booleanFilter>
            <criteriaItems>
                <field>Case.Origin</field>
                <operation>equals</operation>
                <value>Email</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.BillingCountry</field>
                <operation>equals</operation>
                <value>Paraguay</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.BillingCountry</field>
                <operation>equals</operation>
                <value>Bolivia</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.BillingCountry</field>
                <operation>equals</operation>
                <value>Uruguay</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.BillingCountry</field>
                <operation>equals</operation>
                <value>Chile</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.BillingCountry</field>
                <operation>equals</operation>
                <value>Argentina</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.SuppliedEmail</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Priority</field>
                <operation>equals</operation>
                <value>High</value>
            </criteriaItems>
            <notifyCcRecipients>false</notifyCcRecipients>
            <replyToEmail>customerservice.brasil@mosaicco.com</replyToEmail>
            <senderEmail>noreply.customer.service@mosaicco.com</senderEmail>
            <senderName>Mosaic Support</senderName>
            <template>unfiled$public/PMC_SS_Case_Auto_Response_SA</template>
        </ruleEntry>
        <ruleEntry>
            <booleanFilter>1  AND (2 OR 3) AND 4</booleanFilter>
            <criteriaItems>
                <field>Case.Origin</field>
                <operation>equals</operation>
                <value>Email</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.SuppliedEmail</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Contact.Email</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Type</field>
                <operation>notEqual</operation>
                <value>Internal</value>
            </criteriaItems>
            <notifyCcRecipients>false</notifyCcRecipients>
            <replyToEmail>customer.service@mosaicco.com</replyToEmail>
            <senderEmail>noreply.customer.service@mosaicco.com</senderEmail>
            <senderName>Mosaic Support</senderName>
            <template>unfiled$public/PMC_SS_CaseAutoResponse</template>
        </ruleEntry>
    </autoResponseRule>
</AutoResponseRules>
