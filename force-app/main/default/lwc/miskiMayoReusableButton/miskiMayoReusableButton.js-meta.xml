<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="label" type="String" label="Label" description="Label of the Button" default="Label of the Button"/>
            <property name="url" type="String" label="URL" description="URL Link"  default="Insert URL link"/>
            <property name="backgroundColor" type="String" label="Background Color" description="Button background color (hex or color name)" default="red"/>
            <property name="borderColor" type="String" label="Border Color" description="Button border color (hex or color name)" default="black"/>
            <property name="borderThickness" type="String" label="Border Thickness" description="Button border Thickness (number)" default="4"/>
            <property name="borderRadius" type="String" label="Border Radius" description="Button border Radius (number)" default="6"/>
            <property name="textColor" type="String" label="Text Color" description="Button text color (hex or color name)" default="white"/>
            <property name="fontSize" type="String" label="Font Size" description="Button text font size (decimal number)" default="1.2"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>