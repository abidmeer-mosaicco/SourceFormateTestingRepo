<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mosaic Direct - In Transit List</masterLabel>

    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightningCommunity__Default">
            <property name="filterFieldName" type="String" label="Search Field (API)"
                description="API field used by the backend for text search" />
            <property name="dateFilterFieldName" type="String"
                label="Date Filter Field (From - API)"
                description="Date field for the 'From' filter" />
            <property name="endDateFilterFieldName" type="String"
                label="End Date Filter Field (To - API)"
                description="Date field for the 'To' filter" />
            <property name="accountNamePath" type="String" label="Account Name/Id Path"
                description="Path used for account filtering, e.g., PMC_CPQ_OrderProduct__r.Order.Account.Name" />
            <property name="sapNumberPath" type="String" label="SAP Number Path"
                description="Path used for SAP account filtering" />
            <property name="manualFieldApiNames" type="String" label="Manual Field API Names"
                description="CSV with API field paths" required="true" />
            <property name="manualFieldLabelNames" type="String" label="Manual Field Labels (CSV)"
                description="Column labels in the same order as Manual Field API Names" />
            <property name="baseWhereClause" type="String" label="Base WHERE (SOQL fragment)"
                description="Without the word WHERE" />
            <property name="pageSize" type="Integer" label="Page Size" default="50" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>