<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Default</target>
    </targets>
    
    <targetConfigs>
        <!-- App Page Configuration -->
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="maxOrdersDisplay" type="Integer" default="10" 
                      label="Maximum Orders to Display" 
                      description="Maximum number of orders to show at once (0 for unlimited)"/>
            <property name="showEmptyState" type="Boolean" default="true" 
                      label="Show Empty State" 
                      description="Display empty state message when no orders exist"/>
        </targetConfig>
        
        <targetConfig targets="lightning__RecordPage">
            <property name="title" type="String" default="Order Management" 
                      label="Component Title" 
                      description="The title displayed at the top of the component"/>
        </targetConfig>
        
    </targetConfigs>
    
</LightningComponentBundle>