    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "JOIN5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "PMC_SS_AllocationPeriod__c_formula",
          "label" : "Allocation Period Formula",
          "formulaExpression" : "concat(\r\n    case\r\n    When month(PMC_SS_AllocationPeriod__c) = 1\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 01', ' (','January')\r\n     When month(PMC_SS_AllocationPeriod__c) = 2\r\n    then concat(year(PMC_SS_AllocationPeriod__c),' 02', ' (','February')\r\n     When month(PMC_SS_AllocationPeriod__c) = 3\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 03', ' (','March')\r\n     When month(PMC_SS_AllocationPeriod__c) = 4\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 04', ' (','April') \r\n     When month(PMC_SS_AllocationPeriod__c) = 5\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 05', ' (','May')\r\n     When month(PMC_SS_AllocationPeriod__c) = 6\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 06', ' (','June')\r\n     When month(PMC_SS_AllocationPeriod__c) = 7\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 07', ' (','July')\r\n     When month(PMC_SS_AllocationPeriod__c) = 8\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 08', ' (','August')\r\n     When month(PMC_SS_AllocationPeriod__c) = 9\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 09', ' (','September')\r\n     When month(PMC_SS_AllocationPeriod__c) = 10\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 10', ' (','October')\r\n     When month(PMC_SS_AllocationPeriod__c) = 11\r\n    then  concat(year(PMC_SS_AllocationPeriod__c),' 11', ' (','November')\r\n    else\r\n     concat(year(PMC_SS_AllocationPeriod__c),' 12', ' (','December')\r\nend,\r\n')')\r\n\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "AllocatedActualQuantity_STN",
          "label" : "Allocated Actual Quantity ( STN)",
          "formulaExpression" : "Round(PMC_SS_AllocatedActualQuantity__c * 1.10231,2)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
