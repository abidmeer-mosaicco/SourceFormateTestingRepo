    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "SBQQ__ListPrice__c_formula",
          "label" : "Customer Price",
          "formulaExpression" : "(coalesce(PMC_CPQ_NetUnitPrice__c, 0) - coalesce(PMC_CPQ_VolumeDiscount__c, 0))",
          "precision" : 16,
          "scale" : 2,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "PMC_CPQ_PriceComparison_formula",
          "label" : "Price Comparison",
          "formulaExpression" : "case\r\n\twhen SBQQ__ListPrice__c_formula <= PMC_CPQ_PriceGuidanceFloor__c\r\n\tthen \r\n    '1.Below Floor Price'\r\n\telse\r\n\tcase \r\n        when SBQQ__ListPrice__c_formula <= PMC_CPQ_PriceGuidanceTarget__c\r\n        then\r\n        '2.Between floor price and target price'\r\n        else\r\n        case\r\n            when SBQQ__ListPrice__c_formula <= PMC_CPQ_PriceGuidanceCeiling__c\r\n            then\r\n            '3.Between target price and ceiling price'\r\n            else\r\n            case\r\n                when SBQQ__ListPrice__c_formula > PMC_CPQ_PriceGuidanceCeiling__c\r\n                then\r\n                '4.Above Ceiling price'\r\n            end\r\n        end \r\n    end\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "PMC_CPQ_Quantity__c_formula",
          "label" : "Quantity (MTN)",
          "formulaExpression" : "case\r\n\twhen PMC_CPQ_UnitofMeasure__c = 'STN'\r\n\tthen coalesce(SBQQ__Quantity__c, 0)/1.10231\r\n\telse\r\n\tcoalesce(SBQQ__Quantity__c, 0)\r\nend",
          "precision" : 16,
          "scale" : 2,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "PMC_CPQ_SoldToShipToJunction__c_formula",
          "label" : "Weighted Customer Price",
          "formulaExpression" : "SBQQ__ListPrice__c_formula*PMC_CPQ_Quantity__c_formula",
          "precision" : 16,
          "scale" : 2,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "PMC_CPQ_QuoteCreatedDateMonth_formula",
          "label" : "Quote Created Date Month",
          "formulaExpression" : "case \r\nwhen month(\"SBQQ__Quot.CreatedDate\")\r\n = 1 then '1.January'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 2 then '2.February'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 3 then '3.March'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 4 then '4.April'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 5 then '5.May'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 6 then '6.June'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 7 then '7.July'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 8 then '8.August'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 9 then '9.September'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 10 then '10.October'\r\nwhen month(\"SBQQ__Quot.CreatedDate\") = 11 then '11.November'\r\nelse '12.December'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
