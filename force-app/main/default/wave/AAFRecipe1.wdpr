    "EXTRACT0" : {
      "action" : "extractGrains",
      "sources" : [ "JOIN5" ],
      "parameters" : {
        "grainExtractions" : [ {
          "source" : "Period.StartDate",
          "targets" : [ {
            "name" : "Period.Year",
            "label" : "Period.Year",
            "grainType" : "YEAR"
          } ]
        } ]
      }
    },
    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "EXTRACT0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "AccountType",
          "label" : "Account Type",
          "formulaExpression" : "case \r\n\twhen\r\n    \"Account.PMC_SS_Segmentation__c\" = 'Strategic'\r\n\tthen 'B2B'\r\n\twhen\r\n  \t\"Account.PMC_SS_Segmentation__c\" = 'Core' \r\n\tthen 'B2B'\r\n\twhen\r\n    \"Account.PMC_SS_Segmentation__c\" = 'Base' \r\n\tthen 'B2B'\r\n\telse\r\n\t'B2C'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "EXTRACT1" : {
      "action" : "extractGrains",
      "sources" : [ "FORMULA14" ],
      "parameters" : {
        "grainExtractions" : [ {
          "source" : "Period.StartDate",
          "targets" : [ {
            "name" : "Period.StartDate_extract",
            "label" : "Period.Month",
            "grainType" : "MONTH"
          } ]
        } ]
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "EXTRACT1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "PeriodMonthYear",
          "label" : "Period Month Year",
          "formulaExpression" : "concat(\r\n    case\r\n    When \"Period.StartDate_extract\" = 1\r\n    then concat(\"Period.Year\",' 01', ' (','January')\r\n     When \"Period.StartDate_extract\" = 2\r\n    then concat(\"Period.Year\",' 02',' (','February')\r\n     When \"Period.StartDate_extract\" = 3\r\n    then concat(\"Period.Year\",' 03',' (','March')\r\n     When \"Period.StartDate_extract\" = 4\r\n    then concat(\"Period.Year\",' 04',' (','April')\r\n     When \"Period.StartDate_extract\" = 5\r\n    then concat(\"Period.Year\",' 05',' (','May')\r\n     When \"Period.StartDate_extract\" = 6\r\n    then concat(\"Period.Year\",' 06',' (','June')\r\n     When \"Period.StartDate_extract\" = 7\r\n    then concat(\"Period.Year\",' 07',' (','July')\r\n     When \"Period.StartDate_extract\" = 8\r\n    then concat(\"Period.Year\",' 08',' (','August')\r\n     When \"Period.StartDate_extract\" = 9\r\n    then concat(\"Period.Year\",' 09',' (','September')\r\n     When \"Period.StartDate_extract\" = 10\r\n    then concat(\"Period.Year\",' 10',' (','October')\r\n     When \"Period.StartDate_extract\" = 11\r\n    then concat(\"Period.Year\",' 11',' (','November')\r\n    else\r\n    concat(\"Period.Year\",' 12',' (','December')\r\nend,\r\n')')",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CurrentSalesPlan_STN",
          "label" : "Current Sales Plan (STN)",
          "formulaExpression" : "case \r\n\twhen \"UnitOfMeas.Name\" = 'MTN'\r\n\tthen round( PMC_SS_CurrentSalesPlan__c * 1.10231131, 2)\r\n\telse\r\n\tround(PMC_SS_CurrentSalesPlan__c,2)\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "StatisticalBaselineForecast_STN",
          "label" : "Statistical Baseline Forecast (STN)",
          "formulaExpression" : "case \r\n\twhen \"UnitOfMeas.Name\" = 'MTN'\r\n\tthen round(PMC_SS_StatisticalBaselineForecast__c * 1.10231131,2)\r\n\telse\r\n\tround(PMC_SS_StatisticalBaselineForecast__c,2)\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "UnitOfMeasure_STN",
          "label" : "Unit Of Measure STN",
          "formulaExpression" : "case \r\n\twhen \"UnitOfMeas.Name\" = 'MTN' \r\n\tthen 'STN'\r\n\telse\r\n\t\"UnitOfMeas.Name\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
