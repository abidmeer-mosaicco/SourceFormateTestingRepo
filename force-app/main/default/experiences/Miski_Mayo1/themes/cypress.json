  "customCSS" : "@font-face {\n    font-family: 'Gentona Book';\n    src: url('/resource/GentonaFonts/Gentona Book.otf') format('opentype');\n    font-weight: normal;\n    font-style: normal;\n}\n\n/* Apply font globally */\nbody, html, p, h1, h2, h3, h4, h5, h6, a, span, div {\n    font-family: 'Gentona Book', sans-serif!important;\n}\n.js-featured-body{\n  font-size: 13pt;\n}\n\n@media only screen and (min-width:1900px) {\ndiv[role=\"main\"][tabindex=\"-1\"].body.isPageWidthFixed-true {\n    width: auto !important;     /* neutralizes the width defined inline */\n    min-width: 100% !important;\n}\n    \n}\n\n.thirty-percent-tile .js-content-image {\n  background-size: 40% !important; /* Shrinks the icon */\n  width: 10px !important;\n  height: 10px !important;\n}\n.js-content-image.contentImage.transitionEase {\n    width: 100% !important;\n    height: 100% !important;\n}\n\na.bannerLayoutButton.slds-button.slds-button_brand {\n    font-size: 22px;\n    padding: 18px 36px;\n    font-weight: 600;      /* Makes the text bolder */\n}\n\n/* Override SLDS hyphenation globally */\n.slds-hyphenate {\n  hyphens: none !important;\n  word-break: break-word !important;\n  overflow-wrap: break-word !important;\n  white-space: normal !important;\n}\n\n /* Search box for Mobile */\n\n@media (max-width: 767px) {\n\n  /* Magnifying glass button - very light gray background, no border */\n  .forceCommunityThemeSearchSection .search-trigger .search-triggerButton.slds-button_icon-bare,\n  .forceCommunityThemeSearchSection .search-trigger .js-search-triggerButton.slds-button_icon-bare,\n  .forceCommunityThemeSearchSection .search-trigger .search-triggerButton.slds-button_icon-inverse,\n  .forceCommunityThemeSearchSection .search-trigger .js-search-triggerButton.slds-button_icon-inverse,\n  .forceCommunityThemeSearchSection .search-trigger .search-triggerButton {\n    background-color: #eeeeee !important; /* very light gray */\n    border: none !important;              /* borderless */\n    color: #000 !important;               /* black icon */\n    width: 32px !important;\n    height: 32px !important;\n    border-radius: 50% !important;        /* circular button */\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    z-index: 7000 !important;\n  }\n\n  /* Adjusted magnifying glass icon */\n  .forceCommunityThemeSearchSection .search-trigger .search-triggerButton .slds-button__icon,\n  .forceCommunityThemeSearchSection .search-trigger .search-triggerButton svg {\n    width: 18px !important;\n    height: 18px !important;\n    display: block !important;\n  }\n  .forceCommunityThemeSearchSection .search-trigger .search-triggerButton svg path {\n    fill: currentColor !important; /* preto */\n  }\n}",
