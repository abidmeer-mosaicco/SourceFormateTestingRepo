        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<h1 style=\"text-align: center;\"><strong style=\"color: rgb(230, 0, 0); font-size: 48px;\">Código de Conducta Ética del Proveedor</strong></h1><p>&nbsp;</p>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "b3f769b0-6da3-466d-8b3f-ac25b8fd13d5",
          "renderPriority" : "NEUTRAL",
          "renditionMap" : { },
          "type" : "component"
        }, {
          "componentAttributes" : {
            "richTextValue" : "<p style=\"text-align: center;\"><span style=\"font-size: 20px;\">Miski Mayo </span><span style=\"font-size: 20px; background-color: transparent;\">tiene el compromiso de construir un modelo de negocio sostenible y contribuir con una sociedad más justa, ambientalmente equilibrada y económicamente próspera. Para lograr este objetivo, debemos actuar e influenciar de manera positiva y proactiva en cada socio y otras partes involucradas en nuestra cadena productiva.</span></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><span style=\"font-size: 20px;\">El Código de Ética y Conducta del Proveedor tiene por objetivo esclarecer lo que Miski Mayo entiende por conducta ética en las relaciones comerciales con las empresas que nos proporcionan productos y servicios.</span></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><span style=\"font-size: 20px; background-color: transparent;\">Asimismo, esperamos que nuestros proveedores extiendan estos criterios por toda su cadena de valor, o sea, clientes, socios, proveedores de materias primas y proveedores de servicios relacionados, de manera directa o indirecta, con las actividades de la empresa.</span></p><p>&nbsp;</p>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "37c8974a-8766-4e0a-97f7-8ce1fde2f70c",
          "renderPriority" : "NEUTRAL",
          "renditionMap" : { },
          "type" : "component"
        } ],
