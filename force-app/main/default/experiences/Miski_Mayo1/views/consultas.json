        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<div style=\"max-width: 600px; margin: auto;\">\n  <h2 style=\"color: #E2231A; margin-bottom: 20px;\">Consultas</h2>\n\n  <p style=\"margin-bottom: 20px;\">\n    Para brindarte la correcta información referente a nuestra empresa por favor selecciona el área de tu interés y completa los siguientes campos requeridos:\n  </p>\n\n  <p style=\"margin-bottom: 30px;\">\n    Los campos con un asterisco (<span style=\"color: red;\">*</span>) son necesarios.\n  </p>\n\n  <form action=\"https://formsubmit.co/s.yeager875@gmail.com\" method=\"POST\">\n    <label>Área de interés:<span style=\"color: red;\">*</span></label><br />\n    <select name=\"Área de interés\" style=\"width: 100%;\" required>\n      <option value=\"\">Por favor elige uno</option>\n      <option value=\"Ventas\">Ventas</option>\n      <option value=\"Soporte\">Soporte</option>\n      <option value=\"Consultoría\">Consultoría</option>\n    </select><br /><br />\n\n    <label>Nombres y Apellidos:<span style=\"color: red;\">*</span></label><br />\n    <input type=\"text\" name=\"Nombre y Apellido\" style=\"width: 100%;\" required /><br /><br />\n\n    <label>Correo electrónico:<span style=\"color: red;\">*</span></label><br />\n    <input type=\"email\" name=\"Correo electrónico\" style=\"width: 100%;\" required /><br /><br />\n\n    <label>Número de teléfono:</label><br />\n    <input type=\"tel\" name=\"Teléfono\" style=\"width: 100%;\" /><br /><br />\n\n    <label>Ciudad, Provincia:</label><br />\n    <input type=\"text\" name=\"Ciudad, Provincia\" style=\"width: 100%;\" /><br /><br />\n\n    <label>País:</label><br />\n    <input type=\"text\" name=\"País\" style=\"width: 100%;\" /><br /><br />\n\n    <label>Comentarios:</label><br />\n    <textarea name=\"Comentarios\" rows=\"4\" style=\"width: 100%;\"></textarea><br /><br />\n\n    <button type=\"submit\" style=\"padding: 10px 20px; background-color: #E2231A; color: white; border: none; cursor: pointer;\">\n      Enviar\n    </button>\n  </form>\n</div>"
