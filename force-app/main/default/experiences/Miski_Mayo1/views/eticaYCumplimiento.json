          "type" : "component"
        }, {
          "componentAttributes" : {
            "bodyFontSize" : "18",
            "bodyFontWeight" : "400",
            "bodyText" : "Que considera prácticas transparentes de contabilidad y administración, así como la comunicación clara, objetiva y oportuna con los accionistas, inversionistas y mercados de capital.",
            "headerFontSize" : "22",
            "headerFontWeight" : "700",
            "headerText" : "LA BUENA GOBERNANZA",
            "horizontalGapRem" : "1.25",
            "iconAlt" : "",
            "iconName" : "comunicacion-1",
            "iconSize" : "6",
            "maxTextWidth" : "900",
