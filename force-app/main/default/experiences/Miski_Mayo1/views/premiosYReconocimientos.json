        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<h1 style=\"text-align: center;\"><strong style=\"color: rgb(230, 0, 0); font-size: 48px;\">Premios y Reconocimientos</strong></h1><p>&nbsp;</p>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "50b97a7e-2ed3-4a43-8bf3-ac6cc72e6895",
          "renderPriority" : "NEUTRAL",
          "renditionMap" : { },
          "type" : "component"
        }, {
          "componentAttributes" : {
            "richTextValue" : "<p style=\"text-align: center;\"><span style=\"font-size: 18px; color: rgb(72, 72, 72);\">A lo largo de los años, como Miski Mayo, hemos recibido premios y reconocimientos por nuestros logros y aportes en diversos campos, lo que nos permite reafirmar nuestro compromiso de trabajar siempre priorizando la seguridad de nuestra gente, cuidando nuestro planeta y sumando esfuerzos con autoridades y población para contribuir con el desarrollo y progreso de la provincia de Sechura.</span></p>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "916e7461-e1f0-4c95-8664-65254bad71a2",
          "renderPriority" : "NEUTRAL",
