        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<h3><strong style=\"font-size: 36px;\">Objetivo:</strong></h3><p><br></p><p><span style=\"font-size: 22px;\">Este monitoreo tiene como objetivo:</span></p>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "e571127b-1a6a-4d97-90e6-03dc0d22d9e4",
          "renderPriority" : "NEUTRAL",
          "renditionMap" : { },
          "type" : "component"
        }, {
          "componentAttributes" : {
            "richTextValue" : "<div style=\"font-family: Arial, sans-serif; font-size: 16pt; line-height: 1.4; margin-top: 20px;\">\n  <div style=\"display: flex; align-items: flex-start; margin-bottom: 12px;\">\n    <span style=\"color: red; font-weight: bold; font-size: 18pt; margin-right: 10px;\">&#10148;</span>\n    <span>Determinar la calidad del Agua de mar y comparar los resultados con la Normativa Vigente (Estándar de Calidad Ambiental para Agua - DS N°004-2017-MINAM)</span>\n  </div>\n</div>"
          },
          "componentName" : "forceCommunity:htmlBlock",
          "id" : "350085dc-86a7-47cc-8bbc-cbcbcfdcf0e0",
          "renderPriority" : "NEUTRAL",
          "renditionMap" : { },
          "type" : "component"
        }, {
          "componentAttributes" : {
            "richTextValue" : "<p><span style=\"color: rgb(72, 72, 72); font-size: 22px;\">Nuestro monitoreo de calidad de agua superficial se realiza a 4 estaciones las cuales son monitoreadas en 3 niveles de profundidad (superficie, medio y fondo). Asimismo, este monitoreo se realiza de manera mensual.</span></p><p><br></p><p><strong style=\"color: rgb(72, 72, 72); font-size: 22px;\">Ubicación de estaciones:</strong><span style=\"color: rgb(72, 72, 72); font-size: 22px;\">&nbsp;AS-BA-10 (Corriente arriba del muelle de CMMM), AS-BA-20 (Corriente abajo de muelle), AS-BA-30 (Zona de cría de conchas de abanico), AS-BA-40 (Zona de cría de conchas de abanico).</span></p>"
          },
          "componentName" : "forceCommunity:richTextInline",
