          "componentAttributes" : {
            "richTextValue" : "<div style=\"\n  background-color: #FAA635;\n  color: white;\n  font-family: sans-serif;\n  font-size: 48px;\n  font-weight: bold;\n  text-align: center;\n  padding: 20px;\n\n\">\n  ¡Únete a la familia Miski Mayo!\n</div>"
