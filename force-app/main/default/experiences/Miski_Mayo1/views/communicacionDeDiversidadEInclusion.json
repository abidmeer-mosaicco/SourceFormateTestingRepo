            "richTextValue" : "<h2><span style=\"font-size: 28px;\">Programa Promoción del empleo</span></h2>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "db2b9856-d1be-4470-b329-563f0d3ce88f",
          "renderPriority" : "NEUTRAL",
