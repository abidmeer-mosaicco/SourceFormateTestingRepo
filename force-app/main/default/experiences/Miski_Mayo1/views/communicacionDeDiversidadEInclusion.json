        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<h1 style=\"text-align: center;\"><strong style=\"font-size: 36px; color: rgb(230, 0, 0);\">Programas Sociales que promueven </strong></h1><h1 style=\"text-align: center;\"><strong style=\"font-size: 36px; color: rgb(230, 0, 0);\">la Diversidad e Inclusión</strong></h1><p>&nbsp;</p>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "3506158c-e9fd-4927-84ea-215639796e58",
          "renderPriority" : "NEUTRAL",
          "renditionMap" : { },
          "type" : "component"
        }, {
          "componentAttributes" : {
            "richTextValue" : "<p style=\"text-align: center;\"><span style=\"color: rgb(26, 26, 26); font-size: 18px;\">En Miski Mayo buscamos la inclusión de la mujer en los distintos tipos de negocios y/o emprendimientos que nuestra empresa realiza a través de su responsabilidad social en el área de influencia directa. A través de los programas sociales, buscamos que la mujer sechurana desarrolle habilidades y aumente su conocimiento en la puesta en marcha de pequeños negocios que le permitan tener un sustento económico, pero, sobre todo, empoderarse y generar en ellas la autoconfianza.</span></p>"
          },
