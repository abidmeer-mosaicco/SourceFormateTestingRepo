    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This element is used to add MDM team queue to the approver list</description>
        <name>ApproveListQueueAssignment</name>
        <label>Approve List Queue Assignment</label>
        <locationX>842</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>lstApproverIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>GetMasterDataTeamQueue.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>SubmitAccountHierarchyToQueueForApprovalAction</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This element is used to add account owner&apos;s manager to the approver list</description>
        <name>ApproverListAssignment</name>
        <label>Approver List Assignment</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>lstApproverIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>objAccount.Owner.ManagerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>SubmitAccountHierarchyForApproval</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>This constant variable is used to store the api name of flow.</description>
        <name>STRING_FLOW_API_NAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_AccountHierarchyApprovalSubmitFlow</stringValue>
        </value>
    </constants>
    <decisions>
        <description>This element is used to determine the approver of the account hierarchy.</description>
        <name>CheckHierarchyApproverDecision</name>
        <label>Check Hierarchy Approver Decision</label>
        <locationX>1106</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckHierarchyApproverDecision_AssignToManagerOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objAccount.Owner.ManagerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ApproverListAssignment</targetReference>
            </connector>
            <label>Assign to Manager Outcome</label>
        </rules>
        <rules>
            <name>CheckHierarchyApproverDecision_AssignToMDMQueueOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objAccount.Owner.ManagerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetMasterDataTeamQueue</targetReference>
            </connector>
            <label>Assign to MDM Queue Outcome</label>
        </rules>
    </decisions>
    <description>This flow is used to submit the account hierarchy for approval to account owner&apos;s manager or MDM queue in case account owner does not have a manager.</description>
    <environments>Default</environments>
    <formulas>
        <description>Creates a due date for task</description>
        <name>datTaskRecordDueDateFormula</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <formulas>
        <description>This formula resource creates the description for task record</description>
        <name>strApprovalTaskDescription</name>
        <dataType>String</dataType>
        <expression>&apos;Account &apos; + {!objAccount.Name} + &apos; has recently had a modification to it’s hierarchy (Parent Account). Please visit Account &apos; + {!objAccount.Name} + &apos; and click the hierarchy button to review that this information is correct.&apos;</expression>
    </formulas>
    <formulas>
        <description>This formula is used to dynamically create task subject</description>
        <name>strApprovalTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Approve &quot; +{!objAccount.Name}+ &quot;&apos;s new Hierarchy&quot;</expression>
    </formulas>
    <formulas>
        <description>This formula variable is used to create subject of case record dynamically.</description>
        <name>strCaseSubject</name>
        <dataType>String</dataType>
        <expression>&apos;Review Hierarchy for: &apos; + {!objAccount.Name}</expression>
    </formulas>
    <interviewLabel>PMC SS Account Hierarchy Approval Submit Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Account Hierarchy Approval Submit Flow</label>
