    <actionCalls>
        <description>This action submits account record with hierarchy for approval to master data team queue</description>
        <name>SubmitAccountHierarchyToQueueForApprovalAction</name>
        <label>Submit Account Hierarchy To Queue For Approval Action</label>
        <locationX>842</locationX>
        <locationY>458</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <connector>
            <targetReference>GetDefaultBusinessHours</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>ErrorLogCreate</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>objAccount.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>submitterId</name>
            <value>
                <elementReference>objAccount.OwnerId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>nextApproverIds</name>
