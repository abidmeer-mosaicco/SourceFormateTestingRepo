<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>AssignEachOfthePriceBookVariableToCollection</name>
        <label>Assign Each Of the PriceBook Variable To Collection</label>
        <locationX>462</locationX>
        <locationY>1379</locationY>
        <assignmentItems>
            <assignToReference>priceBookEntryCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>priceBookEntrySingle</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopThroughPriceBook</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>AssignSubscriptionPricingToProduct</name>
        <label>Assign Subscription Pricing To Product</label>
        <locationX>198</locationX>
        <locationY>1763</locationY>
        <assignmentItems>
            <assignToReference>$Record.SBQQ__SubscriptionPricing__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Fixed Price</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>UpdateProductRecord</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>AssignValuesToPriceBookEntry</name>
        <label>Assign Values To PriceBook Entry</label>
        <locationX>462</locationX>
        <locationY>1271</locationY>
        <assignmentItems>
            <assignToReference>priceBookEntrySingle.CurrencyIsoCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopThroughOrgCurrencyMetadata.PMC_CPQ_Currency__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>priceBookEntrySingle.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>priceBookEntrySingle.Pricebook2Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopThroughPriceBook.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>priceBookEntrySingle.Product2Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>priceBookEntrySingle.UnitPrice</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>AssignEachOfthePriceBookVariableToCollection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Product_IsActive_Assignment</name>
        <label>Product IsActive Assignment</label>
        <locationX>550</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>$Record.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsProductRecordCreatedOrUpdatedDecision</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>DHPricebookName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>DH Price Book</stringValue>
        </value>
    </constants>
    <constants>
        <name>StandardPricebookName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Standard Price Book</stringValue>
        </value>
    </constants>
    <decisions>
        <name>ConfigSettingDecision</name>
        <label>Config Setting Decision</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>IsProductStatusSetDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ConfigSettingDecision_DontRunOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Don&apos;t Run Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_SAP_Number_Populated</name>
        <label>Is SAP Number Populated</label>
        <locationX>726</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>UpdateProductRecord</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SAP_Number_is_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_SAPProductCode__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_CPQ_SAPProductCode__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_SAP_Number_in_Product_Locations</targetReference>
            </connector>
            <label>SAP Number is Populated</label>
        </rules>
    </decisions>
    <decisions>
        <description>To check if the operations are only to occur on create or update</description>
        <name>IsProductRecordCreatedOrUpdatedDecision</name>
        <label>Is Product Record Created Or Updated Decision</label>
        <locationX>682</locationX>
        <locationY>731</locationY>
        <defaultConnector>
            <targetReference>UpdateProductRecord</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsProductRecordCreatedOrUpdatedDecision_IfNew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Records_Of_PriceBook</targetReference>
            </connector>
            <label>If New</label>
        </rules>
        <rules>
            <name>IsProductRecordCreatedOrUpdatedDecision_IfUpdated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_SAP_Number_Populated</targetReference>
            </connector>
            <label>If Updated</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsProductStatusSetDecision</name>
        <label>Is Product Status Set Decision</label>
        <locationX>682</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>IsProductRecordCreatedOrUpdatedDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsProductStatusSet_ProductIsInactiveRestrictedDeletedOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_ProductStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_ProductStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deleted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_ProductStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Restricted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Product_IsActive_Assignment</targetReference>
            </connector>
            <label>Product Is Inactive/Restricted/Deleted Outcome</label>
        </rules>
    </decisions>
    <description>This flow is to do the after updates for the Product object.</description>
    <environments>Default</environments>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>PMC CPQ After Create/Update Product {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC CPQ After Create/Update Product</label>
    <loops>
        <description>Loop through each of the custom metadata record</description>
        <name>LoopThroughOrgCurrencyMetadata</name>
        <label>Loop Through Org Currency Metadata</label>
        <locationX>198</locationX>
        <locationY>1055</locationY>
        <collectionReference>orgCurrencyMetadataCollection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>LoopThroughPriceBook</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>CreateRecordsOfPriceBookEntryCollection</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>For Each Currency in the metadata collection and for each pricebook in the pricebook collection</description>
        <name>LoopThroughPriceBook</name>
        <label>Loop Through PriceBook</label>
        <locationX>374</locationX>
        <locationY>1163</locationY>
        <collectionReference>priceBookCollection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AssignValuesToPriceBookEntry</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>LoopThroughOrgCurrencyMetadata</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateRecordsOfPriceBookEntryCollection</name>
        <label>Create Records Of PriceBookEntry Collection</label>
        <locationX>198</locationX>
        <locationY>1655</locationY>
        <connector>
            <targetReference>AssignSubscriptionPricingToProduct</targetReference>
        </connector>
        <inputReference>priceBookEntryCollection</inputReference>
    </recordCreates>
    <recordCreates>
        <name>ErrorLogCreate</name>
        <label>Error Log Create</label>
        <locationX>1342</locationX>
        <locationY>2063</locationY>
        <inputAssignments>
            <field>PMC_ExternalId__c</field>
            <value>
                <elementReference>$Flow.CurrentRecord</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_FlowName__c</field>
            <value>
                <stringValue>PMC_CPQ_AfterCreateUpdateProductFlow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Type__c</field>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <object>PMC_ErrorLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>This will retrieve records of Standard and DH pricebook</description>
        <name>Get_Records_Of_PriceBook</name>
        <label>Get Records Of PriceBook</label>
        <locationX>198</locationX>
        <locationY>839</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetRecordsOfOrgCurrenciesMetadata</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.PMC_CPQ_StandardPriceBook</elementReference>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.PMC_CPQ_DHPriceBook</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Pricebook2</object>
        <outputReference>priceBookCollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <sortField>IsStandard</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <description>This will retrieve records of Org Currency metadata and store it in a collection variable</description>
        <name>GetRecordsOfOrgCurrenciesMetadata</name>
        <label>Get Records Of Org Currencies Metadata</label>
        <locationX>198</locationX>
        <locationY>947</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopThroughOrgCurrencyMetadata</targetReference>
        </connector>
        <object>PMC_CPQ_OrgCurrency__mdt</object>
        <outputReference>orgCurrencyMetadataCollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>PMC_CPQ_Currency__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Populate_SAP_Number_in_Product_Locations</name>
        <label>Replicate SAP Number in Product Locations</label>
        <locationX>462</locationX>
        <locationY>947</locationY>
        <connector>
            <targetReference>UpdateProductRecord</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>ErrorLogCreate</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PMC_CPQ_ProductLocationSAPIdentifier__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PMC_CPQ_DeletionIndicator__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>PMC_CPQ_SAPProductCode__c</field>
            <value>
                <elementReference>$Record.PMC_CPQ_SAPProductCode__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.ProductLocations1__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateProductRecord</name>
        <label>Update Product Record</label>
        <locationX>682</locationX>
        <locationY>1955</locationY>
        <faultConnector>
            <targetReference>ErrorLogCreate</targetReference>
        </faultConnector>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ConfigSettingDecision</targetReference>
        </connector>
        <object>Product2</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
