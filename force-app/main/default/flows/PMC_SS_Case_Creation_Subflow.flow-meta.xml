    <decisions>
        <description>To check Account Segmentation not equal to 04, 12, 13 then Assign to Master Data team</description>
        <name>Account_Segmentation_Check</name>
        <label>Account Segmentation Check</label>
        <locationX>446</locationX>
        <locationY>974</locationY>
        <defaultConnector>
            <targetReference>Master_Queue_Get</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SA_Queue_Check</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4 OR 5 OR 6 OR 7)</conditionLogic>
            <conditions>
                <leftValueReference>AccountDetailsGet.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountDetailsGet.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PY</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountDetailsGet.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>13</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountDetailsGet.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>12</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountDetailsGet.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>04</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountDetailsGet.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>08</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountDetailsGet.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>09</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SAQueueGet</targetReference>
            </connector>
            <label>SA Queue Check</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if Account has SAP Customer Number</description>
        <name>CheckIfSAPCustomerNumberNullDecision</name>
        <label>Check If Account SAP Customer Number Null Decision</label>
        <locationX>446</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>AccountSAPNumberAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckIfSAPCustomerNumberNull_NullOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountDetailsGet.PMC_SS_SAPCustomerNumber__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AccountCountryAssignment</targetReference>
            </connector>
            <label>Null Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Decision to check if triggered record is Account or Contact</description>
        <name>IfRecordIsAccountOrContactDecision</name>
        <label>If Record is Account Or Contact Decision</label>
        <locationX>776</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IfRecordIsAccountOrContact_RecordIsAccountOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <elementReference>STRING_ACCOUNT_ID_INITIALS</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AccountDetailsGet</targetReference>
            </connector>
            <label>Record Is Account Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>To check whether new Case is to be assigned to NA or SA GTM Team.</description>
        <name>NASAGTMQueueDecision</name>
        <label>NA / SA GTM Queue Decision</label>
        <locationX>446</locationX>
        <locationY>866</locationY>
        <defaultConnectorLabel>Country Is Blank Or Other Outcome</defaultConnectorLabel>
        <rules>
            <name>NASAGTMQueue_NAQueueOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>strAccountOwnerCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_CANADA</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>strAccountOwnerCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_NORTH_AMERICA</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>strAccountOwnerCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_UNITED_STATES</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NAQueueGet</targetReference>
            </connector>
            <label>NA Queue Outcome</label>
        </rules>
        <rules>
            <name>NASAGTMQueue_SAQueueOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>strAccountOwnerCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_BRAZIL</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>strAccountOwnerCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_PARAGUAY</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_Segmentation_Check</targetReference>
            </connector>
            <label>SA Queue Outcome</label>
        </rules>
    </decisions>
