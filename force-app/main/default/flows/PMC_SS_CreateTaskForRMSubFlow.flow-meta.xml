<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>CheckforRMAndIntegrationUserDecision</name>
        <label>Check for RM And Integration User Decision</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckforRMAndIntegrationUser_RMAndIntegrationUserOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objAccount.PMC_SS_RegionalManager__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objAccount.Owner.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PMC_SS_APIOnlyProfile_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TaskCreationForRMSubFlow</targetReference>
            </connector>
            <label>RM And Integration User Outcome</label>
        </rules>
    </decisions>
    <description>It will create a Task for RM when the Account Has  integration user</description>
    <environments>Default</environments>
    <formulas>
        <name>datDueDateFormula</name>
        <dataType>Date</dataType>
        <expression>TODAY()+7</expression>
    </formulas>
    <formulas>
        <name>strCommentsFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Account &apos; +{!objAccount.Name}+ &apos; needs to be assigned to its correct owner. Currently, it is assigned to an Integration User&apos;</expression>
    </formulas>
    <formulas>
        <name>strSubjectFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Review Account Ownership for Account &apos; +{!objAccount.Name}</expression>
    </formulas>
    <interviewLabel>PMC SS Create Task For RM Sub Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Create Task For RM Sub Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CheckforRMAndIntegrationUserDecision</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>TaskCreationForRMSubFlow</name>
        <label>Task Creation For RM Subflow</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <flowName>PMC_SS_TaskCreationSubFlow</flowName>
        <inputAssignments>
            <name>datDueDate</name>
            <value>
                <elementReference>datDueDateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>PriorityChoice</name>
            <value>
                <elementReference>strPriority</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>StatusChoice</name>
            <value>
                <elementReference>strStatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strComments</name>
            <value>
                <elementReference>strCommentsFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strOwnerId</name>
            <value>
                <elementReference>objAccount.PMC_SS_RegionalManager__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strRelatedTo</name>
            <value>
                <elementReference>objAccount.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strSubject</name>
            <value>
                <elementReference>strSubjectFormula</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>objAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>strPriority</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Normal</stringValue>
        </value>
    </variables>
    <variables>
        <name>strStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Open</stringValue>
        </value>
    </variables>
</Flow>
