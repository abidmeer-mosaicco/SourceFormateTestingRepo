                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Shipping_Address_from_Billing_Address</targetReference>
            </connector>
            <label>Updated Outcome</label>
        </rules>
    </decisions>
