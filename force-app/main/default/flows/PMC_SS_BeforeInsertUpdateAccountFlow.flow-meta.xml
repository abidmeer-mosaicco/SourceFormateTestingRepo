    <decisions>
        <description>Check if SAP Customer Number updated and not blank</description>
        <name>SAPCustomerNumberUpdatedDecision</name>
        <label>SAP Customer Number Updated Decision&apos;</label>
        <locationX>374</locationX>
        <locationY>839</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SAPCustomerNumberUpdatedDecision_UpdatedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_SAPCustomerNumber__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_SAPCustomerNumber__c</leftValueReference>
