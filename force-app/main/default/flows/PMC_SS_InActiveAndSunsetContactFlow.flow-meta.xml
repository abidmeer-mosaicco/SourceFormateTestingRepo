    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CheckContactStatusDecision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
