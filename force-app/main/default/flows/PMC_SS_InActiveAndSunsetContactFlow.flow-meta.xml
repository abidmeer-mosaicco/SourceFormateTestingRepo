    <constants>
        <description>Holds the name of the flow</description>
        <name>STRING_FLOWNAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_InActiveAndSunsetContactFlow</stringValue>
        </value>
    </constants>
    <decisions>
        <name>CheckContactStatusDecision</name>
        <label>Check Contact Status Decision</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>UpdateRecordAndSendNotificationDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckContactStatus_ActiveContactOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateInactiveAssignment</targetReference>
            </connector>
            <label>Active Contact Outcome</label>
        </rules>
        <rules>
            <name>CheckContactStatus_InactiveContactOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_NumberOfInactivityDays__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>730.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateToBeArchivedAssignment</targetReference>
            </connector>
            <label>Inactive Contact Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>UpdateRecordAndSendNotificationDecision</name>
        <label>Update Record And Send Notification Decision</label>
        <locationX>314</locationX>
        <locationY>660</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UpdateRecordAndSendNotification_isUpdateOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isUpdaterecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ContactStatusUpdate</targetReference>
            </connector>
            <label>isUpdate Outcome</label>
        </rules>
    </decisions>
