    <formulas>
        <name>CheckPasswordSize</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!varPassword}) &gt;= 8</expression>
    </formulas>
    <formulas>
        <name>PasswordValidation</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    LEN({!varPassword}) &gt;= 8,

    (
        IF(REGEX({!varPassword}, &quot;.*[0-9].*&quot;), 1, 0) +
        IF(REGEX({!varPassword}, &quot;.*[A-Z].*&quot;), 1, 0) +
        IF(REGEX({!varPassword}, &quot;.*[a-z].*&quot;), 1, 0) +
        IF(
            REGEX(
                {!varPassword},
                &quot;.*[!@#$%^&amp;*()_+\\-={}\\[\\]\\\\|;:&apos;,\\.\\?/`~&gt;].*&quot;
            ),
            1,
            0
        )
    ) &gt;= 3
)</expression>
    </formulas>
