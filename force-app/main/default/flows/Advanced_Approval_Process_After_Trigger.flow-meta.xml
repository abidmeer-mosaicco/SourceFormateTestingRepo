    <formulas>
        <name>FeedBody</name>
        <dataType>String</dataType>
        <expression>IF( CONTAINS(TEXT({!getCaseRecord.CreatedBy.LanguageLocaleKey}), &quot;pt_BR&quot;),
 &quot;Este caso foi rejeitado. Os detalhes de rejeição estão abaixo:&quot;  &amp;
BR() &amp;
 &quot;Assunto:  &quot; &amp;  {!getCaseRecord.Subject}  &amp; 
BR() &amp;
 &quot;Comentários:  &quot; &amp; {!$Record.sbaa__CommentsLong__c},
 &quot;This case has been rejected. The details of the rejection are below: &quot;
&amp; &quot;\nSubject: &quot; &amp; {!getCaseRecord.Subject} &amp; &quot;\nRejection Comments: &quot; &amp; {!$Record.sbaa__CommentsLong__c})</expression>
    </formulas>
    <formulas>
