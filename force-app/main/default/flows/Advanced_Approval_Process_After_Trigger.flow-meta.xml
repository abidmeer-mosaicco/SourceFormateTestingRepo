    </formulas>
    <formulas>
        <name>NotificationBody</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS(TEXT({!getCaseRecord.CreatedBy.LanguageLocaleKey}), &quot;pt_BR&quot;),
 &quot;Comentários: &quot; &amp; {!$Record.sbaa__CommentsLong__c},
  &quot;Rejection Comments: &quot; &amp; {!$Record.sbaa__CommentsLong__c}
)</expression>
    </formulas>
    <formulas>
        <name>NotificationHeader</name>
        <dataType>String</dataType>
        <expression>IF( CONTAINS(TEXT({!getCaseRecord.CreatedBy.LanguageLocaleKey}), &quot;pt_BR&quot;),
 &quot;Seu Caso &quot; &amp; {!getCaseRecord.CaseNumber}&amp; &quot; foi recusado&quot;,
 &quot;Case  &quot; &amp; {!getCaseRecord.CaseNumber} &amp; &quot; has been rejected&quot;
)</expression>
    </formulas>
