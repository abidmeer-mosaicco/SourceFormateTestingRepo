    <formulas>
        <name>AutomateReminderFormula</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.LastModifiedDate} + ({!HoursCalculationFormula}/24)</expression>
    </formulas>
    <formulas>
        <name>booleanIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>DelegatedTimeLimitFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(AND(DATEVALUE({!AutomateReminderFormula}) &gt;=DATEVALUE(DATETIMEVALUE({!$Record.sbaa__Approver__r.sbaa__DelegationStart__c})), 
   DATEVALUE({!AutomateReminderFormula}) &lt;=DATEVALUE(DATETIMEVALUE({!$Record.sbaa__Approver__r.sbaa__DelegationEnd__c}))),true,false)</expression>
    </formulas>
    <formulas>
        <name>HoursCalculationFormula</name>
        <dataType>Number</dataType>
        <expression>VALUE(LEFT(TEXT({!$Record.PMC_CPQ_ReminderFrequency__c}), 1))</expression>
        <scale>0</scale>
    </formulas>
