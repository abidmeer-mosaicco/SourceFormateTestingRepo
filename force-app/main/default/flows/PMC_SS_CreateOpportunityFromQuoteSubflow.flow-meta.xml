            </value>
        </assignmentItems>
        <connector>
            <targetReference>PrimaryContactOnOpportunityUpdate</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>Constant to store Flow API Name</description>
        <name>STRING_FLOWNAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_CreateOpportunityFromQuoteSubflow</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Check if opportunity does not already exist for Quote</description>
        <name>CheckIfOpportunityDoesNotAlreadyExistDecision</name>
        <label>Check if opportunity does not already exist Decision</label>
        <locationX>578</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>CheckIfQuoteIsPrimaryDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckIfOpportunityDoesNotAlreadyExistDecision_DoesNotExistOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objTriggeringQuote.SBQQ__Opportunity2__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignValuesToNewOpportunityAssignment</targetReference>
            </connector>
            <label>Does not Exist Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if Quote is Primary</description>
        <name>CheckIfQuoteIsPrimaryDecision</name>
        <label>Check if Quote is Primary Decision</label>
        <locationX>1106</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckIfQuoteIsPrimaryDecision_PrimaryOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objTriggeringQuote.SBQQ__Primary__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objTriggeringQuote.SBQQ__Opportunity2__r.PMC_SS_SalesAgreement__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetPrimaryContactOfQuoteAssignment</targetReference>
            </connector>
            <label>Primary Outcome</label>
        </rules>
    </decisions>
    <description>Create Opportunity from Quote Subflow</description>
    <environments>Default</environments>
    <formulas>
        <description>Close Date of Opportunity</description>
        <name>dateCloseDateFormula</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <description>Name for Opportunity</description>
        <name>strOpportunityNameFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Quote Generated for&apos; &amp; &apos; &apos; &amp; {!objTriggeringQuote.SBQQ__Account__r.Name}</expression>
    </formulas>
    <interviewLabel>PMC SS Create Opportunity from Quote Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Create Opportunity from Quote Subflow</label>
