            </value>
        </assignmentItems>
        <connector>
            <targetReference>NewOpportunityCreate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign values to quote</description>
        <name>AssignValuesToQuoteAssignment</name>
        <label>Assign values to quote Assignment</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>objTriggeringQuote.SBQQ__Opportunity2__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>objNewOpportunity.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objTriggeringQuote.PMC_CPQ_PriceCheckQuote__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>QuoteUpdate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Get Primary Contact of Quote</description>
        <name>GetPrimaryContactOfQuoteAssignment</name>
        <label>Get Primary Contact of Quote Assignment</label>
        <locationX>842</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>strPrimaryContact</assignToReference>
            <operator>Assign</operator>
