        <locationX>396</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>InsertOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>boolIsNewFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateContactLastInteractionAfterInsertSubFlow</targetReference>
            </connector>
            <label>Insert Outcome</label>
        </rules>
        <rules>
            <name>UpdateOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>boolIsNewFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateContactLastInteractionAfterUpdateSubFLow</targetReference>
            </connector>
            <label>Update Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
