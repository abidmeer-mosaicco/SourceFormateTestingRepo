<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Store Account Id of the Account Team, notification title, User&apos;s Name</description>
        <name>NotificationDetailsAssignment</name>
        <label>Notification Details Assignment</label>
        <locationX>308</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>lstRecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>strNotificationTitle</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Label.PMC_SS_NotificationTitle_NewAccountTeamMember</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>NotifyAccountTeamMembersSubFlow</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>Holds the name of the flow</description>
        <name>STRING_FLOWNAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_NotifyAccountTeamMembersFlow</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Check if Bypass flow condition is enabled for User in Process Switch Custom Settings</description>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>UserDetailsGet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BypassFlowDecision_BypassOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypass Outcome</label>
        </rules>
    </decisions>
    <description>A custom notification is sent to all Account Team Members when a new member is added to the team or existing team member&apos;s role gets changed.</description>
    <environments>Default</environments>
    <formulas>
        <description>Contains the body of the notification</description>
        <name>strNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>{!UserDetailsGet.Name} + &apos; has been added as &apos; + TEXT({!$Record.TeamMemberRole})+ &apos; to &apos; + {!$Record.Account.Name}</expression>
    </formulas>
    <interviewLabel>PMC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Notify Account Team Members Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Log an Error</description>
        <name>ErrorLogCreate</name>
        <label>Error Log Create</label>
        <locationX>572</locationX>
        <locationY>539</locationY>
        <inputAssignments>
            <field>PMC_FlowName__c</field>
            <value>
                <elementReference>STRING_FLOWNAME</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Type__c</field>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <object>PMC_ErrorLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Fetch details of user in Account Team</description>
        <name>UserDetailsGet</name>
        <label>User Details Get</label>
        <locationX>308</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>NotificationDetailsAssignment</targetReference>
        </connector>
        <faultConnector>
            <targetReference>ErrorLogCreate</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UserId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BypassFlowDecision</targetReference>
        </connector>
        <object>AccountTeamMember</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Notify Account Team Members on new Account Team Member addition.</description>
        <name>NotifyAccountTeamMembersSubFlow</name>
        <label>Notify Account Team Members Sub Flow</label>
        <locationX>308</locationX>
        <locationY>647</locationY>
        <flowName>PMC_SS_CustomNotificationSubFlow</flowName>
        <inputAssignments>
            <name>idTargetRecord</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>lstRecipientIds</name>
            <value>
                <elementReference>lstRecipientIds</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strCustomNotificationBody</name>
            <value>
                <elementReference>strNotificationBodyFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strCustomNotificationTitle</name>
            <value>
                <elementReference>strNotificationTitle</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <description>List of Users to whom the notification has to be sent</description>
        <name>lstRecipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Holds the Notification Title</description>
        <name>strNotificationTitle</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
