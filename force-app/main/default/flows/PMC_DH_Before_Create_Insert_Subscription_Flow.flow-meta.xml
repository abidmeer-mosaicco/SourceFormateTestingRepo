        <rules>
            <name>Is_New_Quoteline</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__RevisedSubscription__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
