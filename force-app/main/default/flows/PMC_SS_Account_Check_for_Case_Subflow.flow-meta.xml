<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>API_ONLY_PROFILE</name>
        <dataType>String</dataType>
        <value>
            <stringValue>API Only profile</stringValue>
        </value>
    </constants>
    <constants>
        <name>STRING_CUSTOMER_RECORD_TYPE</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_Customer</stringValue>
        </value>
    </constants>
    <constants>
        <name>STRING_PROSPECT_RECORD_TYPE</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_Prospect</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Checks if the Account is updated</description>
        <name>IsAccountUpdatedDecision</name>
        <label>Is Account Updated Decision</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccountUpdated_AccountRecordTypeChangedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OldAccount.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_PROSPECT_RECORD_TYPE</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewAccount.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_CUSTOMER_RECORD_TYPE</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>API_ONLY_PROFILE</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewAccount.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Indirect</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_a_new_case_record</targetReference>
            </connector>
            <label>Account Record Type Changed Outcome</label>
        </rules>
        <rules>
            <name>IsAccountUpdated_AccountFieldsUpdatedOutcome</name>
            <conditionLogic>1 AND 15 AND 16 AND 17 AND (2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9 OR 10 OR 11 OR 12 OR 13 OR 14 OR 18 OR 19 OR 20 OR 21 OR 22 OR 23 OR 24 OR 25 OR 26 OR 27 OR 28 OR 29)</conditionLogic>
            <conditions>
                <leftValueReference>NewAccount.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_CUSTOMER_RECORD_TYPE</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.PMC_SS_TaxIDOrCNPJOrCPF__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.PMC_SS_TaxIDOrCNPJOrCPF__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.Industry</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.Industry</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.CurrencyIsoCode</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.CurrencyIsoCode</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.PMC_SS_ContractLanguage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.PMC_SS_ContractLanguage__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.Description</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.Description</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.PMC_SS_Segmentation__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.PMC_SS_Segmentation__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.PMC_SS_CPF__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.PMC_SS_CPF__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.PMC_SS_StateTaxNumber__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.PMC_SS_StateTaxNumber__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.PMC_SS_MunicipalTaxNumber__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.PMC_SS_MunicipalTaxNumber__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingPostalCode</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingPostalCode</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingAddress</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingAddress</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>API_ONLY_PROFILE</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewAccount.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Indirect</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpenCasesGet.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.ParentId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.ParentId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingCountryCode</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingCountryCode</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingGeocodeAccuracy</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingGeocodeAccuracy</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingState</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingState</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingCity</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingCity</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingStreet</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingStreet</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingStateCode</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.ShippingStateCode</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingCountry</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingCountry</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingLatitude</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingLatitude</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.BillingLongitude</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.BillingLongitude</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.PMC_SS_Address_Coordinates__Latitude__s</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.PMC_SS_Address_Coordinates__Latitude__s</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OldAccount.PMC_SS_Address_Coordinates__Longitude__s</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>NewAccount.PMC_SS_Address_Coordinates__Longitude__s</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_a_new_case_record</targetReference>
            </connector>
            <label>Account Fields Updated Outcome</label>
        </rules>
    </decisions>
    <description>This sub flow is used to create a case if Customer account is updated</description>
    <environments>Default</environments>
    <interviewLabel>PMC SS Account Check for Case Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Account Check for Case Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>ErrorLogCreate</name>
        <label>Error Log Create</label>
        <locationX>880</locationX>
        <locationY>242</locationY>
        <inputAssignments>
            <field>PMC_FlowName__c</field>
            <value>
                <stringValue>PMC_SS_Account_Check_for_Case_Subflow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Type__c</field>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <object>PMC_ErrorLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get any open cases on Account</description>
        <name>OpenCasesGet</name>
        <label>Open Cases Get</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsAccountUpdatedDecision</targetReference>
        </connector>
        <faultConnector>
            <targetReference>ErrorLogCreate</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>NewAccount.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_IssueReason__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>MDM Verification</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>MDMVerifiedAsFalseUpdate</name>
        <label>MDM Verified As False Update</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>ErrorLogCreate</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>NewAccount.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PMC_SS_MDMVerified__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>OpenCasesGet</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Create_a_new_case_record</name>
        <label>Create a new case record</label>
        <locationX>176</locationX>
        <locationY>542</locationY>
        <connector>
            <targetReference>MDMVerifiedAsFalseUpdate</targetReference>
        </connector>
        <flowName>PMC_SS_Case_Creation_Subflow</flowName>
        <inputAssignments>
            <name>isNew</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>NewAccount.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>NewAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>OldAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
