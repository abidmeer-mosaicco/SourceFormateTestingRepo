<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>CheckForParentAccountDecision</name>
        <label>Check For Parent Account Decision</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckForParentAccount_HavingParentOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objAccount.ParentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreatingTaskForAOSubFlow</targetReference>
            </connector>
            <label>Having Parent Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>datDueDateFormula</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+2</expression>
    </formulas>
    <formulas>
        <description>Hold the body of the Task.</description>
        <name>strTaskCommentFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Account &apos; + {!objAccount.Name} + &apos; was just created, and you are assigned as it’s owner. Please complete the proper data management due diligence by reviewing it’s hierarchy (parent accounts, children accounts) and other Account relationships (Ship-to Accounts, Bill-to Accounts, Payer Accounts, Agents, etc.).&apos;</expression>
    </formulas>
    <formulas>
        <description>Holds the subject of the Task.</description>
        <name>strTaskSubjectFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Review Account Hierarchy for &apos; + {!objAccount.Name}</expression>
    </formulas>
    <interviewLabel>PMC SS Create Task For AO Sub Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Create Task For AO Sub Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
