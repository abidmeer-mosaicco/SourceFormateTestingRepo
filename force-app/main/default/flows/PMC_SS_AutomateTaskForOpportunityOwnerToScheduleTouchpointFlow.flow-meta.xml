    <decisions>
        <description>Process switch custom setting value check to bypass flow.</description>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>CreateTaskDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BypassFlowOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypass Flow Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Element to check whether to create a task for 45 days closure date or task is in Analysis stage since last 10 days.</description>
        <name>CreateTaskDecision</name>
        <label>Create Task Decision</label>
        <locationX>578</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CreateTaskDecision_OpportunityClosingIn45days</name>
            <conditionLogic>1 AND (2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>strOpportunityCloseDateFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PMC_SS_CreateTask_OpportunityCloseDateDuration</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>boolIs45TaskCreated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create45DaysTask</targetReference>
            </connector>
            <label>Opportunity Closing In 45 days</label>
        </rules>
        <rules>
            <name>CreateTaskDecision_OpportunityInAnalysisSince10Days</name>
            <conditionLogic>1 AND (2 OR 3) AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>strAnalysisStageDurationFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PMC_SS_CreateTask_OpportunityAnalysisStageDuration</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_AnalysisStageDate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Analysis</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create10DaysInactiveOpportunityTask</targetReference>
            </connector>
            <label>Opportunity In Analysis Since 10 Days</label>
        </rules>
    </decisions>
    <description>This flow will be executed to automate Tasks for Opportunity Owner to schedule a Touchpoint with a Customer to continue analysis of an Opportunity.</description>
    <environments>Default</environments>
    <formulas>
        <name>boolAnalysisStageDurationFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(
(
TODAY() - {!$Record.PMC_SS_AnalysisStageDate__c}
)
+ 1 = 
VALUE({!$Label.PMC_SS_CreateTask_OpportunityAnalysisStageDuration}) 
+ 1, 
true, 
false
)</expression>
    </formulas>
    <formulas>
        <description>Returns due date 5 days from today</description>
        <name>date5DaysDueDateFormula</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 5</expression>
    </formulas>
    <formulas>
        <description>Returns due date 7 days from today</description>
        <name>date7DaysDueDateFormula</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <formulas>
        <description>Contains the body of the notification</description>
        <name>str10DaysNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;A Task has been assigned to you for Opportunity &apos;+ {!$Record.Name} +&apos; as it is in Analysis for 10 days. Please take appropriate action.&apos;</expression>
    </formulas>
    <formulas>
        <description>Holds the Notification Title</description>
        <name>str10DaysNotificationTitleFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Opportunity &apos;+ {!$Record.Name} +&apos; is in Analysis for 10 days.&apos;</expression>
    </formulas>
    <formulas>
        <description>Contains the Description of a Task</description>
        <name>str10DaysTaskDescriptionFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Your Opportunity &apos;+ {!$Record.Name} +&apos; is in Analysis for 10 days. Please review details around that Opportunity to ensure that it is up to date, and schedule a touchpoint with the customer to ensure momentum continues moving forward!&apos;</expression>
    </formulas>
    <formulas>
        <description>Contains the subject of a Task</description>
        <name>str10DaysTaskSubjectFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Opportunity &apos;+ {!$Record.Name} +&apos; is in Analysis for 10 days.&apos;</expression>
    </formulas>
    <formulas>
        <description>Contains the body of the notification</description>
        <name>str45DaysNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;A Task has been assigned to you for Opportunity &apos;+ {!$Record.Name} +&apos; as it is set to close in 45 days. Please take appropriate action.&apos;</expression>
    </formulas>
    <formulas>
        <description>Holds the Notification Title</description>
        <name>str45DaysNotificationTitleFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Opportunity &apos; + {!$Record.Name} + &apos; is closing in 45 days.&apos;</expression>
    </formulas>
    <formulas>
        <description>Contains the Description of a Task</description>
        <name>str45DaysTaskDescriptionFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Your Opportunity &apos;+ {!$Record.Name} +&apos; is set to close in 45 days. Please review details around that Opportunity to ensure that it is up to date, and schedule a touchpoint with the customer to ensure momentum continues moving forward!&apos;</expression>
    </formulas>
    <formulas>
        <description>Contains the subject of a Task</description>
        <name>str45DaysTaskSubjectFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Opportunity &apos;+ {!$Record.Name} +&apos; Closing in 45 days.&apos;</expression>
    </formulas>
    <formulas>
        <name>strAnalysisStageDurationFormula</name>
        <dataType>String</dataType>
        <expression>TEXT
(
TODAY() - {!$Record.PMC_SS_AnalysisStageDate__c}
)</expression>
    </formulas>
    <formulas>
        <name>strOpportunityCloseDateFormula</name>
        <dataType>String</dataType>
        <expression>TEXT( 
{!$Record.CloseDate} - TODAY()
)</expression>
    </formulas>
