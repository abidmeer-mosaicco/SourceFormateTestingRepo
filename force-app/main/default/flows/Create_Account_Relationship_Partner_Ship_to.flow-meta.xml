    <decisions>
        <description>Checks if the account was created by a user in the Lightning Experience UI.</description>
        <name>Lightning_experience</name>
        <label>Lightning experience</label>
        <locationX>842</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No LE</defaultConnectorLabel>
        <rules>
            <name>Lightning_experience_created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedBy.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.PMC_SS_Profile_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>API Only profile</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Account_Partner_Relationship</targetReference>
            </connector>
            <label>Lightning experience created?</label>
        </rules>
    </decisions>
