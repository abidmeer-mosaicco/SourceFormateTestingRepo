<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Update name of Account Partner Relationship</description>
        <name>UpdateNameAssignment</name>
        <label>Update Name Assignment</label>
        <locationX>242</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PMC_SS_RelatedAccount__r.Name</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <constants>
        <description>Store name of profile</description>
        <name>STRING_PROFILENAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Digital Hub</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Check if Bypass Flow checkbox is true on Process Switches Configuration Setting</description>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>RelatedAccountUpdatedDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BypassFlowDecision_BypassFlowOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.PMC_SS_Profile_Name__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>STRING_PROFILENAME</elementReference>
                </rightValue>
            </conditions>
            <label>Bypass Flow Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if related account is updated or if record is new record</description>
        <name>RelatedAccountUpdatedDecision</name>
        <label>Related Account Updated Decision</label>
        <locationX>374</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RelatedAccountUpdatedDecision_UpdatedOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>boolIsNewFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_RelatedAccount__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateNameAssignment</targetReference>
            </connector>
            <label>Updated Outcome</label>
        </rules>
    </decisions>
    <description>Flow on Account Partner Relationship to update the name as Related Account Name.</description>
    <environments>Default</environments>
    <formulas>
        <description>Store if Account Partner Relationship is new record</description>
        <name>boolIsNewFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>PMC SS Before Insert/Update Account Partner Relationship Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Before Insert/Update Account Partner Relationship Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BypassFlowDecision</targetReference>
        </connector>
        <object>PMC_SS_AccountPartnerRelationships__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
