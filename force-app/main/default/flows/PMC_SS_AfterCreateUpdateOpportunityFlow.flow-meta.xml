            </value>
        </assignmentItems>
        <connector>
            <targetReference>SendAutoGeneratedOpportunityNotification</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>This Decision will check is the Flow Flag is enabled</description>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>578</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Flow Flag Enabled Outcome</defaultConnectorLabel>
        <rules>
            <name>FlowFlagNotEnableOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetOpportunityHistoryRecordsStep</targetReference>
            </connector>
            <label>Flow Flag Not Enable Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>This is a decision where it checks for the field history for the opportunity</description>
        <name>HasConvertedHistoryDecision</name>
        <label>Has Converted History Decision</label>
        <locationX>314</locationX>
        <locationY>492</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>HasConvertedFieldDecision</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunityHistoryRecordsStep.Field</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>opportunityCreatedFromLead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SentAutoGenerateOpportunityEmailStep</targetReference>
            </connector>
            <label>Has Converted Field Decision</label>
        </rules>
    </decisions>
