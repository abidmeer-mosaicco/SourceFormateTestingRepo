    <variables>
        <description>Store Record Type Developer Name of Account</description>
        <name>strRecordTypeDeveloperName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>PMC_SS_Prospect</stringValue>
        </value>
