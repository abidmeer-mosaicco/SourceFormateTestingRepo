                <elementReference>$Label.PMC_SS_AddressChangeNotificationTitle</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>SendOwnerChangeNotificationSubFlow</name>
        <label>Send Owner Change Notification Sub Flow</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <flowName>PMC_SS_CustomNotificationSubFlow</flowName>
        <inputAssignments>
            <name>idTargetRecord</name>
