            <value>
                <elementReference>$Record.SBQQ__Quote__r.PMC_CPQ_LastPricedDate__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Quote_Line_Last_priced_Date_to_TODAY</name>
        <label>Update Quote Line Last priced Date to TODAY</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Last_priced_Date_on_for_the_QL_s_Quote_Record</targetReference>
        </connector>
        <inputAssignments>
            <field>PMC_CPQ_LastPricedDate__c</field>
            <value>
                <elementReference>currentdate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_QL_s_Amendment_Quote_Meets_Conditions</targetReference>
        </connector>
        <filterFormula>AND(
  ISCHANGED({!$Record.PMC_CPQ_CustomerPrice__c}),
  ISPICKVAL({!$Record.SBQQ__Quote__r.SBQQ__Type__c}, &quot;Amendment&quot;),
  ISPICKVAL({!$Record.SBQQ__Quote__r.PMC_CPQ_Region__c}, &quot;North America&quot;)
)</filterFormula>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
