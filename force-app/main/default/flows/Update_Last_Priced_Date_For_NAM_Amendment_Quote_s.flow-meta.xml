    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Last_priced_Date_on_for_the_QL_s_Quote_Record</name>
        <label>Update Last priced Date on  for the QL&apos;s Quote Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>PMC_CPQ_LastPricedDate__c</field>
            <value>
                <elementReference>currentdate</elementReference>
