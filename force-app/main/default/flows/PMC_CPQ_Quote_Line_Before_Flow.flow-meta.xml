    <decisions>
        <description>To check if UoM is MTN or STN</description>
        <name>UoMMTNOrSTNDecision</name>
        <label>UoM MTN Or STN Decision</label>
        <locationX>732</locationX>
        <locationY>2003</locationY>
        <defaultConnector>
            <targetReference>NullifyAccountsUoMAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UoMMTNOrSTNDecision_MTNSTNUoMOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_MTN</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_STN</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>QuantityConversionRequiredDecision</targetReference>
            </connector>
            <label>MTN/STN UoM Outcome</label>
        </rules>
    </decisions>
    <description>This flow will be used to leverage all Before Operations on the Quote Line object</description>
    <environments>Default</environments>
