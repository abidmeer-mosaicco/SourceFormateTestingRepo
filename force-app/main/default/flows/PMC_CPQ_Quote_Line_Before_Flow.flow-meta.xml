    <decisions>
        <description>To compare Account&apos;s and Quote Line&apos;s UoM to check if conversion is required.</description>
        <name>QuantityConversionRequiredDecision</name>
        <label>Quantity Conversion Required Decision</label>
        <locationX>446</locationX>
        <locationY>2111</locationY>
        <defaultConnector>
            <targetReference>QuoteLineIsNewDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>QuantityConversionRequiredDecision_SameUoMOutcome</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_Account__r.PMC_SS_UnitofMeasure__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_MTN</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_MTN</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_Account__r.PMC_SS_UnitofMeasure__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_STN</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_STN</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>QuantityAssignment</targetReference>
            </connector>
            <label>Same UoM Outcome</label>
        </rules>
        <rules>
            <name>QuantityConversionRequiredDecision_STNtoMTNOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_Account__r.PMC_SS_UnitofMeasure__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_MTN</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_STN</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>STNToMTNCustomMetadataGet</targetReference>
            </connector>
            <label>STN to MTN Outcome</label>
        </rules>
        <rules>
            <name>QuantityConversionRequiredDecision_MTNtoSTNOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_Account__r.PMC_SS_UnitofMeasure__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_STN</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_MTN</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MTNToSTNCustomMetadataGet</targetReference>
            </connector>
            <label>MTN to STN Outcome</label>
        </rules>
    </decisions>
