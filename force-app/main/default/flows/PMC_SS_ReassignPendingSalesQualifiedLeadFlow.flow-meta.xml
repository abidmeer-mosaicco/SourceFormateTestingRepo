<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <description>This constant variable stores the API name of flow</description>
        <name>STRING_FLOW_API_NAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_ReassignPendingSalesQualifiedLeadFlow</stringValue>
        </value>
    </constants>
    <constants>
        <description>This constant will store the api name of GTM Brazil Leads Queue.</description>
        <name>STRING_GTM_BRAZIL_LEADS_QUEUE_API_NAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_GTMBrazilLeads</stringValue>
        </value>
    </constants>
    <constants>
        <description>This constant variable is used to store the API name of GTM NA Leads Queue</description>
        <name>STRING_GTM_NA_LEADS_QUEUE_API_NAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_GTMNALeads</stringValue>
        </value>
    </constants>
    <decisions>
        <description>This decision element is used to check if we have to bypass the execution of this flow.</description>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>LeadOwnerReassignmentDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BypassFlowDecision_IsBypassed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Is Bypassed</label>
        </rules>
    </decisions>
    <decisions>
        <description>This decision element will check how many days have been passed since the last email was sent to the retailer for acceptance and if it is more than or equal to 14 it changes the lead owner to GTM queue</description>
        <name>LeadOwnerReassignmentDecision</name>
        <label>Lead Owner Reassignment Decision</label>
        <locationX>842</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>LeadOwnerReassignmentDecision_ChangeOwnerToNAGTMQueueOutcome</name>
            <conditionLogic>1 AND (2 OR 3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>strNumberOfDaysSinceLastEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PMC_SS_LeadRetailerAcceptanceDeadline</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>North America</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canada</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Peru</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetGTMNALeadsQueueRecord</targetReference>
            </connector>
            <label>Change Owner To NA GTM Queue Outcome</label>
        </rules>
        <rules>
            <name>LeadOwnerReassignmentDecision_ChangeOwnerToBrazilGTMQueueOutcome</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>strNumberOfDaysSinceLastEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PMC_SS_LeadRetailerAcceptanceDeadline</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Brazil</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paraguay</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetGTMBrazilLeadsQueueRecord</targetReference>
            </connector>
            <label>Change Owner To Brazil GTM Queue Outcome</label>
        </rules>
    </decisions>
    <description>This flow will reassign the owner to GTM for leads which are in sales qualified status but are not approved or rejected by retailer user in last 14 days.</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula will calculate the number of days that has been passed since the email was triggered.</description>
        <name>strNumberOfDaysSinceLastEmail</name>
        <dataType>String</dataType>
        <expression>TEXT( TODAY() - {!$Record.PMC_SS_RetailerEmailSentDate__c} )</expression>
    </formulas>
    <interviewLabel>PMC SS S {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Reassign Pending Sales Qualified Lead Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>This element is used to create error log records in case of failure.</description>
        <name>ErrorLogCreate</name>
        <label>Error Log Create</label>
        <locationX>1370</locationX>
        <locationY>576</locationY>
        <inputAssignments>
            <field>PMC_FlowName__c</field>
