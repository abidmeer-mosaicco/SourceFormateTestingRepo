    <recordUpdates>
        <description>This element will update the lead owner to GTM Brazil Leads queue</description>
        <name>BRLeadRecordOwnerUpdate</name>
        <label>BR Lead Record Owner Update</label>
        <locationX>842</locationX>
        <locationY>576</locationY>
