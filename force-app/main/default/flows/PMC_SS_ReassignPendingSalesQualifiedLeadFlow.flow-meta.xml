    <recordUpdates>
        <description>This element will update the lead owner to GTM NA Leads queue</description>
        <name>NALeadRecordOwnerUpdate</name>
        <label>NA Lead Record Owner Update</label>
        <locationX>50</locationX>
        <locationY>576</locationY>
