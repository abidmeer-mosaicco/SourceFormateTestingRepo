                </rightValue>
            </conditions>
            <label>Don&apos;t Run Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Agreed_Price_Change</name>
        <label>If Agreed Price Change</label>
        <locationX>539</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Change_in_Agreed_Price</name>
            <conditionLogic>1 AND ((2 AND 3) OR (4 AND 5))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Order.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>North America</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_FinalAgreedPrice__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_FinalAgreedPrice__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_Approval_Process</targetReference>
            </connector>
            <label>Change in Agreed Price</label>
        </rules>
    </decisions>
    <description>GCPM-4521 - FPD Orders NAM PM Approval for Quotes Above Ceiling Price</description>
    <environments>Default</environments>
    <formulas>
        <name>AgreedPriceBeforeFreight</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!$Record.PMC_CPQ_FinalAgreedPrice__c } , 0) - BLANKVALUE({!$Record.PMC_CPQ_EstFreightPrice__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FloorPlusFreight</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Record.PMC_CPQ_Floorprice__c} , 0) + BLANKVALUE({!$Record.PMC_CPQ_EstFreightPrice__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
