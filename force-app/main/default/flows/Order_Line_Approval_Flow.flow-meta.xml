    <decisions>
        <name>Check_for_Approval_Process</name>
        <label>Check for Approval Process</label>
        <locationX>297</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Agreed_Price_Lower_Floor_Price_and_over_10K_ST</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_FinalAgreedPrice__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>FloorPlusFreight</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_OrderItem_Approval</targetReference>
            </connector>
            <label>If Agreed Price Lower Floor Price and over 10K ST</label>
        </rules>
        <rules>
            <name>If_Agreed_Price_Above_Ceiling_Price</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_PriceGuidanceCeiling__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>AgreedPriceBeforeFreight</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Above_Ceiling_Price_Approval_Required</targetReference>
            </connector>
            <label>If Agreed Price Above Ceiling Price</label>
        </rules>
    </decisions>
    <decisions>
        <name>Configure_Setting_Decision</name>
