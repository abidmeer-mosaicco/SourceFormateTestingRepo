        <locationX>440</locationX>
        <locationY>396</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SendInactivityNotificationDecision_InactiveFor5DaysOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>strDaysSinceLastModifiedFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PMC_SS_OpportunityInactivityDuration</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Inactivity_Notification_Email_Action</targetReference>
            </connector>
            <label>Inactive For 5 Days Outcome</label>
        </rules>
    </decisions>
    <description>Scheduled flow to send email notification to Opportunity owners when the Last Modified Date is 5 days older than today.</description>
    <environments>Default</environments>
    <formulas>
        <name>strDaysSinceLastModifiedFormula</name>
        <dataType>String</dataType>
        <expression>TEXT( 
    FLOOR(
