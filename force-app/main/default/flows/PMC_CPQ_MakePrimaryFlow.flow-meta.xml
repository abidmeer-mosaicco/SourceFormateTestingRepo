    <decisions>
        <name>IfOpportunityhavePrimaryQuoteDecision</name>
        <label>If Opportunity have Primary Quote Decision</label>
        <locationX>446</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>PrimaryQuoteScreen1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IfPrimaryQuoteisContractedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetPrimaryQuoteGetRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.PMC_CPQ_ContractStageName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OpportunityContractedErrorScreenDisplay</targetReference>
            </connector>
            <label>If Primary Quote is Contracted Outcome</label>
        </rules>
        <rules>
            <name>ifPrimaryQuoteisthereOutcome</name>
            <conditionLogic>1 AND (2 OR (3 AND 6) OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.SBQQ__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.SBQQ__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.SBQQ__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Presented</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.PMC_CPQ_ContractStageName__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PrimaryQuoteScreen</targetReference>
            </connector>
            <label>if Primary Quote is there Outcome</label>
        </rules>
    </decisions>
