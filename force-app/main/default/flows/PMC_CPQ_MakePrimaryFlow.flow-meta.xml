    <formulas>
        <name>PMC_CPQ_ErrorMessage</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$User.LanguageLocaleKey})=&apos;en_US&apos;,
	TRIM(LEFT(HTMLENCODE({!PMC_CPQ_ErrorMessageRightTrim}), FIND(&apos;You&apos;,HTMLENCODE({!PMC_CPQ_ErrorMessageRightTrim}),0)-1))
	,
	IF(
	TEXT({!$User.LanguageLocaleKey})=&apos;pt_BR&apos;,
	TRIM(LEFT(HTMLENCODE({!PMC_CPQ_ErrorMessageRightTrim}), FIND(&apos;Você&apos;,HTMLENCODE({!PMC_CPQ_ErrorMessageRightTrim}),0)-1)),
		IF(
		TEXT({!$User.LanguageLocaleKey})=&apos;es&apos;,
		TRIM(LEFT(HTMLENCODE({!PMC_CPQ_ErrorMessageRightTrim}), FIND(&apos;Puede&apos;,HTMLENCODE({!PMC_CPQ_ErrorMessageRightTrim}),0)-1)),
		{!$Flow.FaultMessage}
		)
	
	)
	
	)</expression>
    </formulas>
    <formulas>
        <name>PMC_CPQ_ErrorMessageRightTrim</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$User.LanguageLocaleKey})=&apos;en_US&apos;,TRIM(
		RIGHT(
				HTMLENCODE({!$Flow.FaultMessage}) ,(LEN(HTMLENCODE({!$Flow.FaultMessage})) - FIND(&apos;:&apos;, HTMLENCODE({!$Flow.FaultMessage}), 84))
				)
		),
		IF(TEXT({!$User.LanguageLocaleKey})=&apos;pt_BR&apos;,TRIM(
		RIGHT(
				HTMLENCODE({!$Flow.FaultMessage}) ,(LEN(HTMLENCODE({!$Flow.FaultMessage})) - FIND(&apos;:&apos;, HTMLENCODE({!$Flow.FaultMessage}), 84))
				)
		),
		IF(TEXT({!$User.LanguageLocaleKey})=&apos;es&apos;,
		TRIM(
		RIGHT(
				HTMLENCODE({!$Flow.FaultMessage}) ,(LEN(HTMLENCODE({!$Flow.FaultMessage})) - FIND(&apos;:&apos;, HTMLENCODE({!$Flow.FaultMessage}), 84))
				)
		)
		,
		{!$Flow.FaultMessage}
		)
		)
	)</expression>
    </formulas>
