        </rules>
    </decisions>
    <description>Scheduled flow to inactive rebate related records for expired sales agreement records.</description>
    <environments>Default</environments>
    <formulas>
        <description>Formula resource to check if today is the expiration date of rebate program.</description>
        <name>boolExpirationDateFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF( ISBLANK( {!$Record.GracePeriodDayCount} ), 
{!$Record.PMC_SS_SalesAgreement__r.EndDate} &lt;= TODAY(),
({!$Record.PMC_SS_SalesAgreement__r.EndDate} + {!$Record.GracePeriodDayCount} ) &lt;= TODAY() )</expression>
    </formulas>
    <interviewLabel>PMC SS Inactivate Rebate Records Scheduled Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Inactivate Rebate Records Scheduled Flow</label>
