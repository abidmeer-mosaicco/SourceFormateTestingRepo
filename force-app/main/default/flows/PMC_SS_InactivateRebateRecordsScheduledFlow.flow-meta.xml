        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>InactivateRebateProgramDecision_InactivateRecordsOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>boolExpirationDateFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
