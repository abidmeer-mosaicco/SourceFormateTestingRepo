    <decisions>
        <description>Check if the Parent Account is from North America Region</description>
        <name>North_America_Accounts</name>
        <label>Region Account</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NA</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_DG_Account_Name__r.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_DG_Account_Name__r.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_DG_Account_Name__r.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Validate_NAM_Account_Expansion</targetReference>
            </connector>
            <label>NA</label>
        </rules>
        <rules>
            <name>SAM_Sales_Org_4004_and_4005</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_DG_Account_Name__r.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_DG_Account_Name__r.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PY</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SalesOrganization__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>4004</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SalesOrganization__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>4005</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_DG_Account_Name__r.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sold-to</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Validate_SAM_Sold_to_Expansion</targetReference>
            </connector>
            <label>SAM Sales Org 4004 and 4005</label>
        </rules>
    </decisions>
