<apex:component controller="PMC_SS_Case_AA_EmailTemplate_ctrl" access="global">
    <apex:attribute name="cseId" type="Id" assignTo="{!caseId}" description="Case ID to load"/>
    <apex:attribute name="apprvalId" type="Id" assignTo="{!approvalId}" description="Approval ID to load"/>
    
    <html>
    <body>
        <p>Hello {!approvalRecord.Owner.Name},</p>
        
        <p>A Cancel/Rebill case for <strong>{!caseRecord.Account.Name}</strong> has been approved.</p>

        <p>Please review the below details to view the case.</p>

        <h3><u>Case Summary:</u></h3>
        <ul>
            <li>
             <p><strong>Case ID:</strong> {!caseRecord.CaseNumber}</p>
            </li>
        	<li>
                <p><strong>Customer Name:</strong> {!caseRecord.Account.Name}</p>
            </li>
        	<li>
                <p><strong>Case Subject:</strong> {!caseRecord.Subject}</p>
            </li>
            <li>
                <p><strong>Approval Date:</strong> {!approvalRecord.sbaa__Approver__r.LastModifiedDate}</p>
            </li>
            <li>
                <p><strong>Approved By:</strong> {!approvalRecord.sbaa__Approver__r.Name}</p>
            </li>
        </ul>
        
        <h3>Case Details:</h3>
        <table border="1px" style="width:100%; border-collapse:collapse;">
        	<tr>
               <th>Case ID</th>
               <th>Customer Name</th>
               <th>Case Subject</th>
               <th>Approval Date</th>
               <th>Approved By</th>
        	</tr>
        	<tr>
        		<td>{!caseRecord.CaseNumber}</td>
                <td>{!caseRecord.Account.Name}</td>
                <td>{!caseRecord.Subject}</td>
                <td>{!approvalRecord.sbaa__Approver__r.LastModifiedDate}</td>
                <td>{!approvalRecord.sbaa__Approver__r.Name}</td>
        	</tr>
        </table>

        <p>No further action is required from your side at this moment. If you have any questions or need additional information, please feel free to reach out.</p>

        <p>Click <a href="{!caseLink}" target="_blank">here</a> to view the case.</p>

        <p>Thank you,<br/>
        {!approvalRecord.sbaa__Approver__r.Name}</p>
    </body>
    </html>
</apex:component>