<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMC_CPQ_Validate_Materal_Group</fullName>
    <active>true</active>
    <description>Prevent typing characters in material Group field</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Material_Group__c)),
  NOT(REGEX(Material_Group__c, &quot;^[0-9]+$&quot;))
)</errorConditionFormula>
    <errorDisplayField>Material_Group__c</errorDisplayField>
    <errorMessage>The Material Group field must contain numbers only.</errorMessage>
</ValidationRule>
