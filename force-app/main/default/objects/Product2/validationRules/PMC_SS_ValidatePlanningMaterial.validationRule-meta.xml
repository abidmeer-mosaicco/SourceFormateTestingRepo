<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMC_SS_ValidatePlanningMaterial</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(PMCPlanning_Material__c, &quot;^[0-9]*$&quot;))</errorConditionFormula>
    <errorDisplayField>PMCPlanning_Material__c</errorDisplayField>
    <errorMessage>The Planning Material field must contain numbers only. Letters, spaces, and special characters are not allowed.</errorMessage>
</ValidationRule>
