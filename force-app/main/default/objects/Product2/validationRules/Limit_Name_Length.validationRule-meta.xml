<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Limit_Name_Length</fullName>
    <active>true</active>
    <description>Limit the Name in 40 characters</description>
    <errorConditionFormula>LEN(Name) &gt; 40</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>The name of the Product can&apos;t have more than 40 characters</errorMessage>
</ValidationRule>
