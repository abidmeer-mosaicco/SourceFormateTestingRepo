<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMC_SS_ValidateStateTaxNumber</fullName>
    <active>true</active>
    <description>Rule to allow aonly numbers in this field</description>
    <errorConditionFormula>NOT(REGEX(PMC_SS_StateTaxNumber__c, &quot;^[0-9]*$&quot;))</errorConditionFormula>
    <errorDisplayField>PMC_SS_StateTaxNumber__c</errorDisplayField>
    <errorMessage>Only numbers are allowed in the State Tax Number field.</errorMessage>
</ValidationRule>
