<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMC_SS_ValidateEndDateForBulletinNotice</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
	NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),NOT(CONTAINS( $Profile.Name , &apos;Digital Hub&apos; )),
	 RecordType.DeveloperName = $Label.PMC_SS_KnowledgeArticle_BulletinRecordType ,ISNULL( PMC_SS_NumberOfDisplayDays__c ) 
	
)</errorConditionFormula>
