<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMC_SS_TotalCosttoSatisfyBlank</fullName>
    <active>true</active>
    <description>Total Cost to Satisfy is required in order to close a Case.</description>
    <errorConditionFormula>AND(
$RecordType.Name = &quot;Quality&quot;,
ISPICKVAL(Status, &quot;Closed&quot;),
ISBLANK(TEXT (PMC_SS_Total_Cost_to_Satisfy__c ))
)</errorConditionFormula>
    <errorDisplayField>PMC_SS_Total_Cost_to_Satisfy__c</errorDisplayField>
    <errorMessage>Total Cost to Satisfy is required in order to close a Case.</errorMessage>
</ValidationRule>
