<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMC_SS_ValidateCaseStatusBeforeReOpen</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
ISCHANGED(Status),
ISPICKVAL(Status, &apos;Re-Open&apos;),
AND(NOT(ISPICKVAL(PRIORVALUE(Status), &apos;Closed&apos;)),NOT(ISPICKVAL(PRIORVALUE(Status), &apos;Closure Pending&apos;))))</errorConditionFormula>
    <errorMessage>You cannot re-open a Case that has not been closed.</errorMessage>
</ValidationRule>
