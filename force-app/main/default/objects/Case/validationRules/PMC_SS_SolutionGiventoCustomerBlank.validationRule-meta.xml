<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMC_SS_SolutionGiventoCustomerBlank</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
$RecordType.Name = &quot;Quality&quot;,
ISPICKVAL(Status, &quot;Closed&quot;),
ISBLANK(TEXT(PMC_SS_SolutionGiventoCustomer__c))
)</errorConditionFormula>
    <errorDisplayField>PMC_SS_SolutionGiventoCustomer__c</errorDisplayField>
    <errorMessage>Solution Given to Customer is required in order to close a Case.</errorMessage>
</ValidationRule>
