<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Date_Investigation_For_Closed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    RecordType.Name = &quot;Quality&quot;,
    ISPICKVAL(Status, &quot;Closed&quot;),
    ISBLANK(PMC_SS_Date_Investigation_Sent_to_CS__c),
    $User.Username &lt;&gt; &quot;magali.fetter@mosaicco.com.prod&quot;
)</errorConditionFormula>
    <errorDisplayField>PMC_SS_Date_Investigation_Sent_to_CS__c</errorDisplayField>
    <errorMessage>Before closing this case, you must send this investigation to Customer Service. Please indicate the date that you sent the investigation to the team.</errorMessage>
</ValidationRule>
