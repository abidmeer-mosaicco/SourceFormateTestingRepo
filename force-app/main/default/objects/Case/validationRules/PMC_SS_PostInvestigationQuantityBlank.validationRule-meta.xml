<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMC_SS_PostInvestigationQuantityBlank</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
$RecordType.Name = &quot;Quality&quot;,
ISPICKVAL(Status, &quot;Closed&quot;),
ISBLANK(TEXT(PMC_SS_PostInvestigationQuantity__c))
)</errorConditionFormula>
    <errorDisplayField>PMC_SS_PostInvestigationQuantity__c</errorDisplayField>
    <errorMessage>Post Investigation Quantity is required in order to Closed a Case.</errorMessage>
</ValidationRule>
