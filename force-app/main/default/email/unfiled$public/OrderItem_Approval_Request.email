<messaging:emailTemplate subject="FPD Called Price Approval Request - Order {!relatedTo.OrderNumber}" recipientType="User" relatedToType="Order">
    <messaging:htmlEmailBody >
        <html>
            <head>
                <meta content="text/css;charset=utf-8" http-equiv="Content-Type"/>
                <meta name="Template" content="Response"/>
            </head>
            <body>
                <apex:outputPanel >
                    <b>
                        <p>FPD Called Price Approval Request</p>
                    </b>
                </apex:outputPanel>
                <apex:outputPanel >
                    Final Agreeded Price is below the Floor Price + Freight OR over 10,000 ST
                </apex:outputPanel>
                <br/> <br/>
                <apex:outputPanel >
                    Hello {!Recipient.Name}, <br/><br/>
                    A order for {!relatedTo.Account.Name} has been submitted for your approval by {!$User.FirstName}. 
                </apex:outputPanel>
                <c:PMC_CPQ_OrderApprovalRequestedEmail orderRecordId="{!relatedTo.Id}"
                    approvalReqStatus="Requested"
                />
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>