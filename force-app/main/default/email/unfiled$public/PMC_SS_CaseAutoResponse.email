<![CDATA[<div style=""><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Dear&nbsp;</span><font face="arial">{!Case.SuppliedName}<span style="font-size: 12pt;">,</span></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Thank you for submitting your inquiry. Case {!Case.CaseNumber}:{!Case.Subject} has been created and a representative will review and respond to you during business hours (8:00 AM EST - 5:00 PM EST or&nbsp;</span><span style="font-size: 12pt;">8:00 AM BST - 5:00 PM BST</span><span style="font-size: 12pt;">), Monday through Friday.</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">We do our best to reply quickly and appreciate your patience.</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Best Regards,</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">Mosaic Customer Care</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">&nbsp;<img src="https://globaldigitalacceleration--devp1.sandbox.file.force.com/servlet/servlet.ImageServer?id=015DT000001GtHy&amp;oid=00DDT000000Bzj5" border="0" align="left" alt=""><br></font></div>]]></td>
