    <pathAssistantSteps>
        <info>&lt;p&gt;At this Stage you need to:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Convert Quote Document to Contract via DocuSign&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Record PO#, if available with the Customer&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Record Delivery Cadence&lt;/p&gt;</info>
        <picklistValueName>Accepted</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;At this Stage you need to:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Generate Quote Proposal Document in the right language&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Review the Quote Proposal document for business, product &amp;amp; price discrepancy, if any.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Send the Quote Proposal Document to Customer(s)&lt;/p&gt;</info>
        <picklistValueName>Approved</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;At this Stage you need to:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Add Products to the Quote Edit Lines&lt;/li&gt;&lt;li&gt;Capture Discount, Ship To and all other Mandatory fields in the Quote Edit Lines&lt;/li&gt;&lt;li&gt;Review Price Target, floor and ceiling while capturing discounts&lt;/li&gt;&lt;li&gt;Click “Get Price” to get Quote Price details&lt;/li&gt;&lt;li&gt;Send Quote for Approval&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Discuss &amp;amp; Capture Competitor products, price &amp;amp; discounts to offer a competitive Quote&lt;/p&gt;</info>
        <picklistValueName>Draft</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;At this Stage you need to:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Get Customer’s acceptance on the Quote Proposal via email or DocuSign (Digital Acceptance)&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Send Reminder, if necessary, to get acceptance before the Quote End Date&lt;/p&gt;</info>
        <picklistValueName>Presented</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;At this Stage you need to:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;Accept/Reject the Quote Requested by the Customer from DH&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Symbol; font-size: 13px;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;font-size: 7pt;&quot;&gt;      &lt;/span&gt;If Reject, please add the “Reason/Comment for Rejection&lt;/p&gt;</info>
        <picklistValueName>Request</picklistValueName>
    </pathAssistantSteps>
